function destinationSearch(d){event?.preventDefault?.();activeFilters.dest=[d];document.querySelectorAll('.f-dest').forEach(x=>x.checked=x.value===d);go('safaris')}
function renderTours(){let list=[...tours];if(activeFilters.dest.length)list=list.filter(t=>activeFilters.dest.some(d=>t.dest.includes(d)));if(activeFilters.style.length)list=list.filter(t=>activeFilters.style.includes(t.style));if(activeFilters.type.length)list=list.filter(t=>activeFilters.type.includes(t.type));list=list.filter(t=>t.price<=activeFilters.max);let sort=document.getElementById('sortTours')?.value;if(sort==='low')list.sort((a,b)=>a.price-b.price);if(sort==='high')list.sort((a,b)=>b.price-a.price);if(sort==='duration')list.sort((a,b)=>a.duration-b.duration);document.getElementById('allTours').innerHTML=list.length?list.map(card).join(''):'<div class="empty">No tours match these filters. Try adjusting your search.</div>';document.getElementById('resultCount').textContent=`Showing ${list.length} of ${tours.length} sample experiences`;document.getElementById('resultTitle').textContent=activeFilters.dest.length?`${activeFilters.dest.join(', ')} experiences`:'Safari experiences'}
function syncFilters(){activeFilters.dest=[...document.querySelectorAll('.f-dest:checked')].map(x=>x.value);activeFilters.style=[...document.querySelectorAll('.f-style:checked')].map(x=>x.value);activeFilters.type=[...document.querySelectorAll('.f-type:checked')].map(x=>x.value);activeFilters.max=+document.getElementById('maxPrice').value;document.getElementById('priceLabel').textContent=activeFilters.max>=8000?'$8,000+':'$'+activeFilters.max.toLocaleString();renderTours()}
document.querySelectorAll('.filters input').forEach(x=>x.addEventListener('change',syncFilters));document.getElementById('sortTours').addEventListener('change',renderTours);function clearFilters(){document.querySelectorAll('.filters input[type=checkbox]').forEach(x=>x.checked=false);document.getElementById('maxPrice').value=8000;syncFilters()}
function toggleSave(id,btn){if(saved.has(id)){saved.delete(id);btn.classList.remove('active');btn.textContent='♡';toast('Removed from saved tours')}else{saved.add(id);btn.classList.add('active');btn.textContent='♥';toast('Tour saved to your collection')} }
function showSaved(){go('saved')};function renderSaved(){let list=tours.filter(t=>saved.has(t.id));document.getElementById('savedTours').innerHTML=list.length?list.map(card).join(''):'<div class="empty">You have not saved any tours yet. Explore our safari experiences and tap ♡ to save one.</div>'}
function openDetail(id){currentTour=tours.find(t=>t.id===id);let t=currentTour;document.getElementById('detailContent').innerHTML=`<div class="crumb">SAFARIS / ${t.dest.join(' / ').toUpperCase()}</div><div class="detail-top"><div><h1>${t.title}</h1><div class="tour-meta"><span>◷ ${t.duration} DAYS</span><span>⌖ ${t.dest.join(' · ')}</span><span>★ ${t.rating} (${t.reviews} reviews)</span></div></div><button class="btn btn-outline" onclick="toggleSave(${t.id},this)">${saved.has(t.id)?'♥ Saved':'♡ Save tour'}</button></div><div class="detail-gallery"><img src="${t.image}" alt="${t.title}"><img src="https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=600&q=80" alt="Safari landscape"><img src="https://images.unsplash.com/photo-1534177616072-ef7dc120449d?auto=format&fit=crop&w=600&q=80" alt="Wildlife"><img src="https://images.unsplash.com/photo-1549366021-9f761d450615?auto=format&fit=crop&w=600&q=80" alt="Safari camp"><img src="https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=600&q=80" alt="African plains"></div><div class="detail-columns"><div><div class="panel"><h3>About this experience</h3><p>${t.desc} Your local guide will help you make the most of every stop, with time for wildlife viewing, photography and memorable moments.</p><div class="tour-tags"><span class="tag">${t.style}</span><span class="tag">${t.type}</span><span class="tag">${t.duration} days</span></div></div><div class="panel"><h3>Day-by-day itinerary</h3>${t.itinerary.map((x,i)=>`<div class="itinerary-day"><strong>DAY ${i+1}</strong><p>${x}</p></div>`).join('')}</div><div class="panel"><h3>What's included</h3><ul><li>Professional English-speaking safari guide</li><li>Transport in a safari vehicle (as described by operator)</li><li>Accommodation as specified in the final quotation</li><li>Planned activities and park visits, subject to final confirmation</li></ul><h3>Important information</h3><p>Prices and itinerary are illustrative sample content for this front-end prototype. Confirm exact inclusions, availability, park fees and payment terms with the operator before booking.</p></div><div class="panel"><h3>Tour operator</h3><p><strong>${t.operator}</strong> · ★ ${t.rating} (${t.reviews} sample reviews)</p><p>Operator profile and verification are demonstration data in this prototype.</p></div></div><aside><div class="panel booking-card"><div class="kicker">YOUR ADVENTURE AWAITS</div><div class="booking-price">$${t.price.toLocaleString()} <span style="font:12px var(--site-font-body);color:#7b867e">/ person</span></div><p>Indicative sample price. Final quote depends on dates and group size.</p><div class="field"><label>Preferred travel date</label><input type="date" id="detailDate"></div><div class="field"><label>Travellers</label><select id="detailTravellers"><option>2 travellers</option><option>1 traveller</option><option>3 travellers</option><option>4 travellers</option><option>5+ travellers</option></select></div><button class="btn btn-primary" onclick="openQuote(${t.id})">Request a quotation →</button><button class="btn btn-outline" onclick="go('request')">Customise this trip</button><p style="font-size:10px;text-align:center">No payment required to enquire.</p></div></aside></div>`;go('detail')}
function openQuote(id){currentTour=tours.find(t=>t.id===id);document.getElementById('quoteTourName').textContent=currentTour.title+' · Sample from $'+currentTour.price.toLocaleString()+' per person';document.getElementById('quoteModal').classList.add('open')};function closeQuote(){document.getElementById('quoteModal').classList.remove('open')}
async function submitToApi(path,payload){let response=await fetch('/api/'+path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});let result=await response.json();if(!response.ok)throw new Error(result.error||'Unable to submit your request');return result}
document.getElementById('quoteForm').addEventListener('submit',async e=>{e.preventDefault();let data=Object.fromEntries(new FormData(e.target));let s=document.getElementById('quoteSuccess');try{let result=await submitToApi('quotes',{tourId:currentTour?.id,name:data.name,email:data.email,travelDate:data.date,travellers:data.travellers,message:data.message});let ref=result.data.id.slice(0,8).toUpperCase();requests.push({ref,tour:currentTour?.title||'Custom enquiry',name:data.name,email:data.email,status:'Received'});s.textContent=`Thank you, ${data.name}. Your quotation request ${ref} has been received.`;s.classList.add('show');e.target.reset();toast('Quotation request received')}catch(error){s.textContent=error.message;s.classList.add('show');toast('We could not submit your request')}})
function formSubmit(id,successId,msg,path,transform){document.getElementById(id).addEventListener('submit',async e=>{e.preventDefault();let data=Object.fromEntries(new FormData(e.target));let s=document.getElementById(successId);try{await submitToApi(path,transform?transform(data):data);s.textContent=msg+(data.name?' Thank you, '+data.name+'.':'');s.classList.add('show');e.target.reset()}catch(error){s.textContent=error.message;s.classList.add('show');toast('We could not submit your message')}})}
formSubmit('requestForm','requestSuccess','Your trip request has been received.','requests',data=>({...data,arrivalDate:data.date}));formSubmit('contactForm','contactSuccess','Thank you. Your message has been received.','contact');
function renderDashboard(){document.getElementById('dashContent').innerHTML=`<div class="kicker">OPERATOR WORKSPACE · DEMO</div><h2>Good day, Tanzania Famtour</h2><p style="font-size:12px;color:#7b867e">A front-end preview of the operator management portal.</p><div class="dash-cards"><div class="dash-card"><span>Published sample tours</span><strong>06</strong></div><div class="dash-card"><span>Enquiries this session</span><strong>${requests.length.toString().padStart(2,'0')}</strong></div><div class="dash-card"><span>Saved by visitors</span><strong>${saved.size.toString().padStart(2,'0')}</strong></div></div><div class="dash-table"><h3>Recent enquiries</h3><table><thead><tr><th>Reference</th><th>Tour / enquiry</th><th>Customer</th><th>Status</th></tr></thead><tbody>${requests.length?requests.map(r=>`<tr><td>${r.ref}</td><td>${r.tour}</td><td>${r.name}</td><td><span class="tag">${r.status}</span></td></tr>`).join(''):'<tr><td colspan="4">No enquiries recorded yet. Submit a quotation request to see it appear here.</td></tr>'}</tbody></table></div>`}
function dashTab(tab,el){document.querySelectorAll('.dash-link').forEach(x=>x.classList.remove('active'));el.classList.add('active');if(tab==='overview')renderDashboard();else{let c=document.getElementById('dashContent');if(tab==='tours')c.innerHTML='<div class="kicker">TOUR MANAGEMENT</div><h2>My tours</h2><p style="font-size:12px;color:#758078">Sample listings for the front-end demonstration.</p><div class="dash-table"><table><tr><th>Tour</th><th>Price</th><th>Status</th></tr>'+tours.map(t=>`<tr><td>${t.title}</td><td>$${t.price.toLocaleString()}</td><td><span class="tag">Sample published</span></td></tr>`).join('')+'</table></div>';if(tab==='requests')c.innerHTML='<div class="kicker">CUSTOMER COMMUNICATION</div><h2>Enquiries</h2><p style="font-size:12px;color:#758078">Requests submitted in this browser session.</p><div class="dash-table"><table><tr><th>Reference</th><th>Tour</th><th>Customer</th><th>Status</th></tr>'+(requests.length?requests.map(r=>`<tr><td>${r.ref}</td><td>${r.tour}</td><td>${r.name}</td><td>${r.status}</td></tr>`).join(''):'<tr><td colspan="4">No enquiries yet.</td></tr>')+'</table></div>';if(tab==='profile')c.innerHTML='<div class="kicker">COMPANY PROFILE</div><h2>Tanzania Famtour</h2><div class="panel" style="margin-top:20px"><p><strong>Profile status:</strong> Demo profile</p><p><strong>Business category:</strong> Safari and travel marketplace</p><p><strong>Location:</strong> Tanzania, East Africa</p><p><strong>Contact:</strong> hello@tanzaniafamtour.com (placeholder)</p><p style="font-size:11px;color:#8a938c">Profile editing and document verification require a connected backend in the production system.</p></div>'}}
function toast(s){let el=document.getElementById('toast');el.textContent=s;el.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.classList.remove('show'),2600)}
document.getElementById('homeSearch').addEventListener('submit',e=>{e.preventDefault();let d=document.getElementById('homeDestination').value,style=document.getElementById('homeStyle').value;activeFilters={dest:d?[d]:[],style:style?([style==='Private'?'':style].filter(Boolean)):[],type:style==='Private'?['Private']:[],max:8000};document.querySelectorAll('.f-dest,.f-style,.f-type').forEach(x=>x.checked=(x.classList.contains('f-dest')&&activeFilters.dest.includes(x.value))||(x.classList.contains('f-style')&&activeFilters.style.includes(x.value))||(x.classList.contains('f-type')&&activeFilters.type.includes(x.value)));go('safaris')});
function init(){document.getElementById('featuredTours').innerHTML=tours.slice(0,3).map(card).join('');document.getElementById('homeOperators').innerHTML=operators.slice(0,3).map(operatorCard).join('');document.getElementById('allOperators').innerHTML=operators.map(operatorCard).join('');document.getElementById('allDestinations').innerHTML=destinations.map((d,i)=>`<a class="dest-card" href="#safaris" onclick="destinationSearch('${d[3]}')"><img src="${d[2]}" alt="${d[0]}"><div class="dest-info"><span>${d[1]}</span><h3>${d[0]}</h3><small>Explore experiences →</small></div></a>`).join('');renderTours()};init();
</script><script>
// Reliable mobile navigation: handle the menu explicitly and keep it above page content.
(()=>{
  const menu=document.querySelector('.menu-toggle');
  const nav=document.getElementById('navlinks');
  if(!menu||!nav)return;
  menu.onclick=null;
  menu.setAttribute('aria-label','Toggle navigation menu');
  menu.setAttribute('aria-expanded','false');
  menu.addEventListener('click',e=>{
    e.preventDefault();
    e.stopPropagation();
    const isOpen=nav.classList.toggle('open');
    menu.setAttribute('aria-expanded',String(isOpen));
  });
  nav.style.zIndex='31';
  nav.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{
    nav.classList.remove('open');
    menu.setAttribute('aria-expanded','false');
  }));
  document.addEventListener('click',e=>{
    if(!nav.contains(e.target)&&!menu.contains(e.target)){
      nav.classList.remove('open');
      menu.setAttribute('aria-expanded','false');
    }
  });
  document.addEventListener('keydown',e=>{
    if(e.key==='Escape'){
      nav.classList.remove('open');
      menu.setAttribute('aria-expanded','false');
    }
  });
})();
</script></body></html>
